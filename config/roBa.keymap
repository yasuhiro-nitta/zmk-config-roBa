#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        kana {
            bindings = <&kp LANG1>;
            key-positions = <17 18>;
        };

        eisuu {
            bindings = <&kp LANG2>;
            key-positions = <13 14>;
        };

        left-click {
            bindings = <&mkp MB1>;
            key-positions = <30 31>;
        };

        right-click {
            bindings = <&mkp MB2>;
            key-positions = <31 32>;
        };

        left-normal {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <13 12>;
        };

        right-normal {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 10>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
        };

        left-bracket {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <2 3>;
        };

        right-bracket {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <6 7>;
        };

        left-brace {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 12>;
        };

        right-brace {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
        };

        middle-click {
            bindings = <&mkp MB3>;
            key-positions = <32 33>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        apostrophe {
            bindings = <&kp SQT>;
            key-positions = <6 18>;
        };

        quote2 {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <18 30>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <5 17>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <17 29>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <7 19>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <19 31>;
        };

        grave-accent {
            bindings = <&kp GRAVE>;
            key-positions = <3 13>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <13 25>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <4 14>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <14 26>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <8 20>;
        };

        slash {
            bindings = <&kp PERCENT>;
            key-positions = <32 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W             &kp E         &kp R             &kp T                                                   &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A           &kp S             &kp D         &kp F             &kp G        &lt 4 LG(LS(NUMBER_4))      &trans         &kp H        &kp J  &lt 5 K    &kp L    &kp MINUS
&kp LEFT_SHIFT  &kp Z             &kp X         &kp C             &kp V        &trans                      &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN    &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LS(LEFT_GUI)  &lt 2 SPACE  &kp LC(UP_ARROW)            &kp BACKSPACE  &lt 1 ENTER                             &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        NumberArrow {
            bindings = <
&kp N1   &kp N2  &kp N3             &kp N4                &kp N5                             &kp N6        &kp N7        &kp N8    &kp N9         &kp N0
&kp TAB  &trans  &kp C_VOLUME_UP    &kp C_BRI_INC         &kp EQUAL  &kp C_MUTE      &trans  &kp ASTERISK  &kp LEFT      &kp UP    &kp RIGHT      &trans
&trans   &trans  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC  &kp PLUS   &trans          &trans  &kp PLUS      &kp LG(LEFT)  &kp DOWN  &kp LG(RIGHT)  &trans
&trans   &trans  &trans             &trans                &trans     &trans          &trans  &trans                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        Symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH           &kp DOLLAR  &kp PERCENT                          &kp CARET  &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &trans       &kp C_VOLUME_UP    &bl BL_INC  &trans       &kp C_MUTE      &trans  &trans     &kp LC(LEFT)   &kp LC(UP_ARROW)  &kp LC(RIGHT)         &trans
&trans           &trans       &kp C_VOLUME_DOWN  &bl BL_DEC  &trans       &trans          &trans  &trans     &kp LG(LEFT)   &kp LC(DOWN)      &kp LG(RIGHT)         &trans
&trans           &trans       &trans             &trans      &trans       &trans          &trans  &trans                                                            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
